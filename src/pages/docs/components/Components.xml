<templates>
  <t t-name="Components">
    <div class="p-8">
      <article>
        <h1 class="text-4xl font-bold mb-4 text-[var(--doc-heading-color)]">
          Components</h1>
        <p class="text-lg mb-8 text-[var(--doc-text-color)]">
          MetaOWL uses OWL (Odoo Web Library) components for building your UI.
        </p>

        <h2 id="creating-components"
          class="text-xl font-semibold mt-8 mb-4 text-[var(--doc-heading-color)]">Creating
          Components</h2>
        <p class="mb-4 text-[var(--doc-text-color)]">Create components in the <code
            class="px-1.5 py-0.5 rounded text-sm bg-[var(--doc-inline-code-bg)]">
          src/components/</code> directory:</p>
        <pre class="language-javascript p-4 rounded-lg overflow-x-auto text-sm mb-6"><code class="language-javascript">// src/components/Button/Button.js
import { Component } from '@odoo/owl'

export class Button extends Component {
  static template = 'Button'
  static props = ['label', 'onClick']
}</code></pre>

        <h2 id="templates"
          class="text-xl font-semibold mt-8 mb-4 text-[var(--doc-heading-color)]">
          Templates</h2>
        <p class="mb-4 text-[var(--doc-text-color)]">Define the component template in an XML
          file:</p>
        <pre class="language-xml p-4 rounded-lg overflow-x-auto text-sm mb-6"><code class="language-xml">&lt;templates&gt;
  &lt;t t-name="Button"&gt;
    &lt;button class="btn" t-on-click="props.onClick"&gt;
      &lt;t t-esc="props.label"/&gt;
    &lt;/button&gt;
  &lt;/t&gt;
&lt;/templates&gt;</code></pre>

        <h2 id="lifecycle"
          class="text-xl font-semibold mt-8 mb-4 text-[var(--doc-heading-color)]">Lifecycle
          Hooks</h2>
        <p class="mb-4 text-[var(--doc-text-color)]">OWL provides several lifecycle hooks:</p>
        <ul class="mb-4 text-[var(--doc-text-color)] list-disc pl-6">
          <li class="mb-2"><code
              class="px-1.5 py-0.5 rounded text-sm bg-[var(--doc-inline-code-bg)]">
            setup()</code> - Called before mounting</li>
          <li class="mb-2"><code
              class="px-1.5 py-0.5 rounded text-sm bg-[var(--doc-inline-code-bg)]">
            mounted()</code> - Called after mounting</li>
          <li class="mb-2"><code
              class="px-1.5 py-0.5 rounded text-sm bg-[var(--doc-inline-code-bg)]">
            willUnmount()</code> - Called before unmounting</li>
        </ul>

        <h2 id="try-it" class="text-xl font-semibold mt-8 mb-4 text-[var(--doc-heading-color)]">Try It Yourself</h2>
        <!-- Interactive Example -->
        <div class="bg-gray-100 dark:bg-[#1e202e] border border-gray-300 dark:border-none rounded-lg p-6 mb-8">
          <p class="text-gray-700 dark:text-gray-300 mb-4 text-sm">This example shows a simple OWL component with props and event handling.</p>
          
          <div class="flex flex-col gap-4 mb-4">
            <div class="flex flex-col gap-2">
              <label class="text-gray-700 dark:text-gray-300 text-sm">Button Label:</label>
              <input type="text" t-model="state.buttonLabel" class="px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 text-sm" />
            </div>
            
            <div class="flex gap-2 items-center">
              <button t-on-click="handleClick" t-attf-class="px-4 py-2 text-base font-medium text-white border-none rounded-md cursor-pointer transition-all hover:opacity-90 {{ state.buttonStyle === 'primary' ? 'bg-blue-500' : 'bg-violet-500' }}">
                <t t-esc="state.buttonLabel"/>
              </button>
              <span class="text-gray-700 dark:text-gray-300 text-sm">Clicked: <strong t-esc="state.clickCount"/>x</span>
            </div>
          </div>
          
          <div class="flex gap-2 mb-4">
            <button t-on-click="toggleStyle" class="px-4 py-2 bg-gray-500 text-white border-none rounded-md cursor-pointer text-sm font-medium hover:bg-gray-600 transition-colors">Toggle Style</button>
            <button t-on-click="resetCount" class="px-4 py-2 bg-red-500 text-white border-none rounded-md cursor-pointer text-sm font-medium hover:bg-red-600 transition-colors">Reset</button>
          </div>
          
          <div class="bg-gray-200 dark:bg-black/30 p-3 rounded-md text-sm">
            <p class="text-gray-800 dark:text-gray-200 mb-1"><strong>Component Code:</strong></p>
            <pre class="text-gray-700 dark:text-gray-300 m-0 text-xs overflow-x-auto"><code>&lt;button 
  class="btn" 
  t-on-click="props.onClick"
  t-attf-style="background: {{ state.buttonStyle }}"&gt;
  &lt;t t-esc="props.label"/&gt;
&lt;/button&gt;</code></pre>
          </div>
        </div>
      </article>
    </div>
  </t>
</templates>